generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  driverId  String?
  partnerId String?
  createdAt DateTime @default(now())
}

model Driver {
  id Int @id @default(autoincrement())

  // ...
  name    String
  phone   String?
  vehicle String?
  area    String?
  photo   String? // base64 (demo)
  active  Boolean  @default(true)
  orders  Order[]
  payouts Payout[]
}

model Partner {
  id      String  @id @default(uuid())
  name    String
  contact String?
  phone   String?
  notes   String?
  active  Boolean @default(true)
  orders  Order[]
}

model Order {
  id        String      @id @default(uuid())
  // other fields...
  createdAt DateTime    @default(now())
  orderNo   String?
  revenue   Float
  status    OrderStatus
  notes     String?
  driverId  Int?
  partnerId String?
  driver    Driver?     @relation(fields: [driverId], references: [id])
  partner   Partner?    @relation(fields: [partnerId], references: [id])
}

model Payout {
  id        Int      @id @default(autoincrement())
  driverId  Int
  amount    Float
  period    String
  status    String
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])
}

model Meta {
  id      String @id @default("singleton")
  company Json
  targets Json
}

enum Role {
  ADMIN
  dispatcher
  driver
  partner
  DISPATCHER
  DRIVER
  PARTNER
}

enum OrderStatus {
  DELIVERED_ON_TIME
  DELIVERED_LATE
  FAILED
}
